# Public settings baked into the site at build time (safe to be seen).
# Copy to .env for local builds. On Cloudflare Pages, add them under
# Settings → Variables and secrets (as plain text, for the build).

# Turnstile site key (Cloudflare dashboard → Turnstile). Leave empty to skip the bot check.
VITE_TURNSTILE_SITE_KEY=

# Force the form's preview mode on or off. Unset: on in `npm run dev`, off in real builds.
# VITE_FORM_DEMO=true
